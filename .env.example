# Copy to `.env` and fill in your values.

# --- OpenAI ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
TEMPERATURE=0.0

# --- Embeddings ---
# Encoder backend: "openai" or "huggingface".
EMBEDDING_PROVIDER=openai

# --- Hugging Face encoders (used when EMBEDDING_PROVIDER=huggingface) ---
# Any model id from the Hub. multilingual-e5 works well for Ukrainian text.
HF_EMBEDDING_MODEL=intfloat/multilingual-e5-base
# cpu, cuda, cuda:0, mps, ...
HF_DEVICE=cpu
HF_NORMALIZE_EMBEDDINGS=true

# --- Qdrant (embedded, on-disk vector DB) ---
# Qdrant runs in-process and persists to this local directory. No server needed.
QDRANT_PATH=qdrant_data
COLLECTION_NAME=ukr_criminal_code

# --- Ingestion / retrieval ---
SOURCE_FILE=docs/ukr_cc_ready.txt
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
TOP_K=5
